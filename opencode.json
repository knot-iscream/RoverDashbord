{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "D:/Git/DigitalTwinDashboard/**": "allow"
    },
    "read": {
      "*": "allow",
      "D:/Git/DigitalTwinDashboard/**": "allow"
    },
    "glob": {
      "*": "allow",
      "D:/Git/DigitalTwinDashboard/**": "allow"
    },
    "grep": {
      "*": "allow",
      "D:/Git/DigitalTwinDashboard/**": "allow"
    },
    "edit": {
      "*": "ask",
      "D:/Git/DigitalTwinDashboard/**": "deny"
    },
    "bash": {
      "*": "ask",
      "*DigitalTwinDashboard*": "deny"
    }
  }
}
