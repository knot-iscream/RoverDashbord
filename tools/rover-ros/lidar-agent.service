[Unit]
Description=Rover LiDAR service agent
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=iscream-pi
WorkingDirectory=/home/iscream-pi/rover-ros
ExecStart=/usr/bin/python3 /home/iscream-pi/rover-ros/scripts/lidar_agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
