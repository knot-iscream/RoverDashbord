[Unit]
Description=Rover ESP32 USB serial to MQTT bridge
After=mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=iscream-pi
WorkingDirectory=/home/iscream-pi/rover-serial-bridge
Environment=BRIDGE_PORTS=/dev/ttyUSB1,/dev/ttyUSB2,/dev/ttyUSB3
Environment=BRIDGE_DEFAULT_NODE=
Environment=MQTT_BROKER=127.0.0.1
Environment=MQTT_PORT=1883
ExecStart=/usr/bin/python3 /home/iscream-pi/rover-serial-bridge/serial_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
