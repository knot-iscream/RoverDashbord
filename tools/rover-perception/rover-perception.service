[Unit]
Description=Rover perception (NanoDet detector)
After=network-online.target rover-cam.service
Wants=network-online.target rover-cam.service

[Service]
Type=simple
User=iscream-pi
WorkingDirectory=/home/iscream-pi/rover-perception
Environment=PERCEPTION_STREAM=http://127.0.0.1:8081/stream.mjpg
Environment=PERCEPTION_INTERVAL=0.20
Environment=PERCEPTION_CONF=0.35
ExecStart=/usr/bin/python3 /home/iscream-pi/rover-perception/perception.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
