{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoverDash",
  "version": "2.0.2",
  "identifier": "com.roverdash.app",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RoverDash",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Starting RoverDash",
        "url": "splash.html",
        "width": 420,
        "height": 220,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/mosquitto-x86_64-pc-windows-msvc.exe",
      "binaries/mosquitto_common.dll",
      "binaries/libcrypto-3-x64.dll",
      "binaries/libssl-3-x64.dll",
      "binaries/libmicrohttpd-dll.dll",
      "binaries/cjson.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
